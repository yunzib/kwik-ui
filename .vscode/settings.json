{
    "cmake.generator": "Ninja",
    // CMake Tools 固定走 preset 体系（状态栏 preset 选择器切 gcc=Debug /
    // gcc-release=Release 档；Select Variant 的变体面板不参与）
    "cmake.useCMakePresets": "always",
    "clangd.path": "C:/software/llvm-mingw/bin/clangd.exe",
    "clangd.arguments": [
        "--compile-commands-dir=${workspaceFolder}/build",
        "--query-driver=C:/software/llvm-mingw/bin/g++.exe",
        "--log=verbose",
        "--pretty",
        "--all-scopes-completion",
        "--completion-style=bundled",
        "--cross-file-rename",
        "--header-insertion=never",
        // 保留后台索引，但降低其优先级 (平衡性能与功能)
        "--background-index",
        "--background-index-priority=low", 
        "--clang-tidy",
        "--clang-tidy-checks=cppcoreguidelines-*,performance-*,bugprone-*,portability-*,modernize-*,google-*",
        "-j=1",
        "--pch-storage=disk",
        "--function-arg-placeholders=false",
        "--experimental-modules-support",
    ],
    // 为 C/C++ 指定 clangd 扩展作为默认 formatter
    "[cpp]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
        "editor.formatOnSave": true
    },
    "[c]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
        "editor.formatOnSave": true
    }
}