#############################################
# Rule for generating CXX dependencies.

rule CXX_SCAN__view_example_Release
  depfile = $DEP_FILE
  command = C:\Windows\system32\cmd.exe /C ""C:/software/llvm-mingw/bin/clang-scan-deps.exe" -format=p1689 -- C:\software\llvm-mingw\bin\clang++.exe $DEFINES $INCLUDES $FLAGS -x c++ $in -c -o $OBJ_FILE -resource-dir "C:/software/llvm-mingw/lib/clang/22" -MT $DYNDEP_INTERMEDIATE_FILE -MD -MF $DEP_FILE > $DYNDEP_INTERMEDIATE_FILE.tmp && "C:/software/cmake/bin/cmake.exe" -E rename $DYNDEP_INTERMEDIATE_FILE.tmp $DYNDEP_INTERMEDIATE_FILE"
  description = Scanning $in for CXX dependencies


#############################################
# Rule to generate ninja dyndep files for CXX.

rule CXX_DYNDEP__view_example_Release
  command = C:\software\cmake\bin\cmake.exe -E cmake_ninja_dyndep --tdi=examples\CMakeFiles\view_example.dir\CXXDependInfo.json --lang=CXX --modmapfmt=clang --dd=$out @$out.rsp
  description = Generating CXX dyndep file $out
  rspfile = $out.rsp
  rspfile_content = $in
  restat = 1


