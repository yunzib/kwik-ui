#############################################
# Rule for re-running cmake.

rule RERUN_CMAKE
  command = C:\software\cmake\bin\cmake.exe --regenerate-during-build -SC:\ws-code\ws-kwik\kwik-ui -BC:\ws-code\ws-kwik\kwik-ui\build
  description = Re-running CMake...
  generator = 1


#############################################
# Rule for cleaning all built files.

rule CLEAN
  command = C:\software\ninja-win\ninja.exe $FILE_ARG -t clean $TARGETS
  description = Cleaning all built files...


#############################################
# Rule for printing all primary targets available.

rule HELP
  command = C:\software\ninja-win\ninja.exe -t targets
  description = All primary targets available:

